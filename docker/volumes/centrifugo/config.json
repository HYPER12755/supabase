{
  "http_server": {
    "port": 8000
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "http://centrifugo-auth:8090/auth/subscribe",
        "timeout": "5s",
        "include_connection_meta": true
      },
      "publish": {
        "endpoint": "http://centrifugo-auth:8090/auth/publish",
        "timeout": "5s",
        "include_connection_meta": true
      }
    },
    "namespaces": [
      {
        "name": "tenant",
        "subscribe_proxy_enabled": true,
        "publish_proxy_enabled": true,
        "presence": true,
        "join_leave": true,
        "force_push_join_leave": false,
        "history_size": 100,
        "history_ttl": "300s",
        "history_meta_ttl": "1h",
        "force_recovery": true,
        "allow_subscribe_for_client": false,
        "allow_subscribe_for_anonymous": false,
        "allow_publish_for_client": false,
        "allow_publish_for_anonymous": false,
        "allow_history_for_client": false,
        "allow_presence_for_client": false,
        "allow_history_for_subscriber": true,
        "allow_presence_for_subscriber": true
      },
      {
        "name": "user",
        "subscribe_proxy_enabled": true,
        "publish_proxy_enabled": true,
        "presence": true,
        "join_leave": true,
        "force_push_join_leave": false,
        "history_size": 100,
        "history_ttl": "300s",
        "history_meta_ttl": "1h",
        "force_recovery": true,
        "allow_subscribe_for_client": false,
        "allow_subscribe_for_anonymous": false,
        "allow_publish_for_client": false,
        "allow_publish_for_anonymous": false,
        "allow_history_for_client": false,
        "allow_presence_for_client": false,
        "allow_history_for_subscriber": true,
        "allow_presence_for_subscriber": true
      },
      {
        "name": "public",
        "subscribe_proxy_enabled": true,
        "publish_proxy_enabled": true,
        "presence": true,
        "join_leave": true,
        "force_push_join_leave": false,
        "history_size": 100,
        "history_ttl": "300s",
        "history_meta_ttl": "1h",
        "force_recovery": true,
        "allow_subscribe_for_client": false,
        "allow_subscribe_for_anonymous": false,
        "allow_publish_for_client": false,
        "allow_publish_for_anonymous": false,
        "allow_history_for_client": false,
        "allow_presence_for_client": false,
        "allow_history_for_subscriber": true,
        "allow_presence_for_subscriber": true
      }
    ],
    "publication_data_format": "json_object"
  },
  "health": {
    "enabled": true
  },
  "prometheus": {
    "enabled": true
  },
  "admin": {
    "enabled": false
  },
  "log": {
    "level": "info"
  }
}
