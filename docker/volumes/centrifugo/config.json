{
  "http_server": {
    "port": 8000
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "http://centrifugo-auth:8090/auth/subscribe",
        "timeout": "5s",
        "include_connection_meta": true
      },
      "publish": {
        "endpoint": "http://centrifugo-auth:8090/auth/publish",
        "timeout": "5s",
        "include_connection_meta": true
      }
    },
    "namespaces": [
      {
        "name": "tenant",
        "subscribe_proxy_enabled": true,
        "publish_proxy_enabled": true
      },
      {
        "name": "user",
        "subscribe_proxy_enabled": true,
        "publish_proxy_enabled": true
      },
      {
        "name": "public",
        "subscribe_proxy_enabled": true,
        "publish_proxy_enabled": true
      }
    ]
  },
  "health": {
    "enabled": true
  },
  "prometheus": {
    "enabled": true
  },
  "admin": {
    "enabled": false
  },
  "log": {
    "level": "info"
  }
}
