# Centrifugo beta environment. Generate local values with:
#   sh utils/generate-centrifugo-keys.sh
#
# Do not commit the generated .env.centrifugo file.

# HMAC secret used to sign and verify Centrifugo connection tokens.
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=replace-with-a-strong-random-secret

# Token-signing rotation: set the old secret and its Unix expiry before changing
# CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY. Clear both after the expiry.
# CENTRIFUGO_CLIENT_TOKEN_HMAC_PREVIOUS_SECRET_KEY=
# CENTRIFUGO_CLIENT_TOKEN_HMAC_PREVIOUS_SECRET_KEY_VALID_UNTIL=

# Server-to-server Centrifugo HTTP API key. Never expose this to clients.
CENTRIFUGO_HTTP_API_KEY=replace-with-a-strong-random-key

# Database roles created by the centrifugo-migrate Compose service.
# Replace POSTGRES_HOST, POSTGRES_PORT, and POSTGRES_DB with this deployment's
# values, or use the defaults from docker/.env.
CENTRIFUGO_AUTH_DB_PASSWORD=replace-with-a-strong-random-password
CENTRIFUGO_OUTBOX_DB_PASSWORD=replace-with-a-strong-random-password
CENTRIFUGO_AUTH_DATABASE_URL=postgresql://centrifugo_auth:replace-with-a-strong-random-password@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB
CENTRIFUGO_OUTBOX_DATABASE_URL=postgresql://centrifugo_outbox:replace-with-a-strong-random-password@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DB

# Phase 3 defaults; override only when the deployment needs shorter or longer
# token or authorization-cache lifetimes.
# CENTRIFUGO_AUTH_TOKEN_TTL_SECONDS=900
# CENTRIFUGO_AUTHZ_CACHE_TTL_SECONDS=5
# CENTRIFUGO_AUTHZ_CACHE_VERSION=1

# Admin UI is disabled by default. Enable only for internal troubleshooting.
# CENTRIFUGO_ADMIN_PASSWORD=replace-me
# CENTRIFUGO_ADMIN_SECRET=replace-me

# Redis scale-out is configured separately in .env.centrifugo-scale and loaded
# only by docker-compose.centrifugo-scale.yml. See .env.centrifugo-scale.example.
